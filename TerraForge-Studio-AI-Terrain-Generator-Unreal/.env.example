# ========================================
# TerraForge Studio - Configuration
#
# Copy to .env and edit. Every key here is optional: the defaults in
# realworldmapgen/config.py are used for anything you leave out, and unknown
# keys are ignored rather than rejected.
#
# List values accept either a JSON array (["a","b"]) or a comma-separated
# list (a,b).
# ========================================

# Application Settings
APP_NAME=TerraForge Studio
APP_VERSION=2.0.0
ENVIRONMENT=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend
FRONTEND_URL=http://localhost:5173
# Accepts a JSON array or a plain comma-separated list.
# A wildcard is deliberately unsupported: browsers reject "*" together with
# credentialed requests, so origins must be listed explicitly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost

# ========================================
# Geospatial Data Sources
# ========================================

# Sentinel Hub (Satellite Imagery)
# Get your API key from: https://www.sentinel-hub.com/
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
SENTINELHUB_INSTANCE_ID=
SENTINELHUB_ENABLED=false

# OpenTopography (High-resolution DEMs)
# Get your API key from: https://opentopography.org/
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_ENABLED=false

# Azure Maps (Vector data, routing, POI)
# Get your key from: https://azure.microsoft.com/services/azure-maps/
AZURE_MAPS_SUBSCRIPTION_KEY=
AZURE_MAPS_ENABLED=false

# Google Earth Engine (Advanced geospatial analysis)
# Requires service account JSON - see: https://developers.google.com/earth-engine/
GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT=
GOOGLE_EARTH_ENGINE_PRIVATE_KEY_PATH=
GOOGLE_EARTH_ENGINE_ENABLED=false

# SRTM / Open Terrain Tiles (elevation)
# Free, global, no registration required - this is the default elevation
# source and is what makes generation work out of the box.
SRTM_ENABLED=true
SRTM_MAX_ZOOM=14
# Upper bound on tiles fetched per request; caps bandwidth for large areas.
SRTM_MAX_TILES=256
SRTM_CONCURRENCY=8
SRTM_TIMEOUT=30
SRTM_TILE_CACHE_ENABLED=true

# OpenStreetMap vector data (roads, buildings, land use)
#
# Two paths exist. Overpass speaks plain HTTP and needs no extra packages, so
# it is the default. OSM_ENABLED uses osmnx, which is richer but requires the
# optional geospatial stack: pip install -r requirements-optional.txt
OVERPASS_ENABLED=true
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT=90
# Overpass is a shared public service; larger areas are skipped, not submitted.
OVERPASS_MAX_AREA_KM2=25.0

OSM_USER_AGENT=TerraForge-Studio/2.0
OSM_ENABLED=true

# ========================================
# Terrain Generation Settings
# ========================================

# Default Resolution (pixels)
DEFAULT_HEIGHTMAP_RESOLUTION=2048
MIN_RESOLUTION=512
MAX_RESOLUTION=8192

# Area Limits (km²)
MAX_AREA_KM2=100.0
DEFAULT_AREA_KM2=10.0

# Height Range (meters)
DEFAULT_HEIGHT_MIN=-256
DEFAULT_HEIGHT_MAX=256

# Elevation source priority for elevation_source="auto".
# Options: opentopography, azure_maps, srtm
ELEVATION_SOURCE_PRIORITY=opentopography,azure_maps,srtm

# When every configured source fails, fall back to procedural terrain.
# Such results are always flagged as synthetic in the API response.
# Set to false to fail the request instead.
ALLOW_SYNTHETIC_FALLBACK=true

# ========================================
# Export Settings
# ========================================

# Unreal Engine 5
UE5_HEIGHTMAP_FORMAT=16bit_png  # 16bit_png or raw
UE5_DEFAULT_LANDSCAPE_SIZE=2017  # 1009, 2017, 4033, 8129
UE5_EXPORT_WEIGHTMAPS=true
UE5_EXPORT_SPLINES=true

# Unity
UNITY_HEIGHTMAP_FORMAT=raw  # raw or 16bit_png
UNITY_DEFAULT_TERRAIN_SIZE=2049  # 513, 1025, 2049, 4097
UNITY_EXPORT_SPLATMAPS=true
UNITY_EXPORT_TREES=true

# Generic Formats
# Cap on GLTF mesh vertices per side. Heightmaps are decimated to this size
# before triangulation, keeping meshes usable in real-time engines.
GLTF_MAX_MESH_RESOLUTION=512

# ========================================
# Processing Settings
# ========================================

# Performance
PARALLEL_PROCESSING=true
MAX_WORKERS=4
CHUNK_SIZE=1024

# Caching
ENABLE_CACHE=true
CACHE_DIR=./cache
CACHE_EXPIRY_DAYS=30
CACHE_MAX_SIZE_GB=10.0

# Output
OUTPUT_DIR=./output
TEMP_DIR=./temp

# ========================================
# AI Settings (Optional)
# ========================================

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:235b-cloud
OLLAMA_CODER_MODEL=qwen3-coder:480b-cloud
OLLAMA_TIMEOUT=300
OLLAMA_ENABLED=false

# AI Features
ENABLE_AI_TERRAIN_ANALYSIS=false
ENABLE_AI_MATERIAL_CLASSIFICATION=false
ENABLE_AI_BUILDING_HEIGHT_ESTIMATION=false

# ========================================
# Feature Toggles
# ========================================

# Default Feature Flags
ENABLE_ROADS=true
ENABLE_BUILDINGS=true
ENABLE_VEGETATION=true
ENABLE_WATER_BODIES=true

# Advanced Features
ENABLE_3D_PREVIEW=true
ENABLE_MATERIAL_LAYERS=true
ENABLE_PROCEDURAL_ROADS=true
ENABLE_BATCH_PROCESSING=false

# ========================================
# Logging
# ========================================

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=./logs/terraforge.log
# json or text
LOG_FORMAT=text

# ========================================
# Security
# ========================================

# Deployment-level API key gate. When enabled, every /api request must send
# X-API-Key (or Authorization: Bearer <key>) matching one of API_KEYS.
# /api/health, /health*, /metrics and the docs stay open for probes.
# Enabling this with an empty API_KEYS rejects everything rather than failing
# open, so set at least one key.
API_KEY_ENABLED=false
API_KEYS=

# User accounts (see docs/API_EXAMPLES.md#authentication-and-users).
# Passwords are stored as salted PBKDF2-HMAC-SHA256. Kept out of CACHE_DIR on
# purpose: clearing the cache must never delete credentials.
AUTH_STORAGE_FILE=data/users.json

# Settings written by the settings UI, including credentials it encrypts.
SETTINGS_STORAGE_FILE=data/settings.json

# Fernet key encrypting those credentials. Generated at random on first use;
# back it up, and never commit it. Deleting it means re-entering every key.
SECRET_KEY_FILE=data/.secret_key

# Rate Limiting (enforced by middleware; see docs/API_EXAMPLES.md)
# /health* and /metrics are always exempt so probes are never throttled.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000
# Enable ONLY behind a reverse proxy that overwrites X-Forwarded-For.
# When clients can set the header themselves, trusting it lets them bypass
# the limit by rotating the value.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# CORS
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=*
