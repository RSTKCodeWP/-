{
  "name": "hades-ui",
  "version": "0.0.0",
  "description": "HADES coordinator UI shell (Electron + React + TypeScript)",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "dev:landing": "vite --mode landing",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "build:landing": "tsc --noEmit && vite build --mode landing",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "vite build && vite build --mode web && vite build --mode landing",
    "test:e2e": "playwright test",
    "test:all": "vitest run && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/urbanist": "^5.2.7",
    "@fontsource/b612": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^5.24.0",
    "mgrs": "^2.1.0",
    "pmtiles": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.9"
  }
}
