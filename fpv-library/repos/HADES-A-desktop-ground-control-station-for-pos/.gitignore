# ---- Python (service/) ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Node / UI (ui/) ----
node_modules/
dist/
dist-electron/
.vite/
*.tsbuildinfo
test-results/
playwright-report/
blob-report/
.playwright/

# ---- Models & data (large / generated artifacts) ----
*.mlpackage/
*.mlmodel
*.onnx
*.pt
models/
# ML dataset staging dir under the Python service ONLY. The old bare `data/` pattern also
# swallowed `ui/src/data/` (real source) and `docs/documentation/data/` (doc CSVs), which broke
# the web build on CI. Scope it to the service so source data folders stay tracked.
/service/data/
# Trained-model artifacts pulled back from the cluster (best.pt + args.yaml + results.csv +
# requirements.lock). Versioned artifacts, never committed.
artifacts/
# Dataset archives staged locally for upload to the cluster (HERIDAL/SARD/VisDrone).
# These are versioned artifacts, never committed (plan: weights/data live on the
# cluster / as release artifacts, not in git).
*.zip
SARD/
HERIDAL/
VisDrone/
datasets/

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/

# ---- Stray non-project files ----
cs1.pdf
.gstack/
.vercel

# ---- Claude / AI assistant files (kept on disk, out of the repo) ----
# the whole Claude working dir (config, memory, deploy script, state)
.claude/
# Claude project + working notes
CLAUDE.md
tasks/
# any root-level markdown that isn't the README (keeps docs/ tracked, ignores stray notes)
/*.md
!/README.md
# other AI / assistant tool dirs and files
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md
.continue/
.codeium/
.windsurf/
*.ai.md
