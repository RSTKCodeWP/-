{
  "name": "@ardudeck/launcher",
  "version": "0.1.0",
  "description": "ArduDeck Trainer launcher: pick a region, conditions and vehicle, then start the game",
  "author": {
    "name": "rubenCodeforges",
    "email": "ruben@codeforges.com"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "lucide-react": "^0.562.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "28.3.3",
    "electron-builder": "^26.7.0",
    "electron-vite": "^2.0.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.ardudeck.launcher",
    "productName": "ArduDeck Trainer",
    "npmRebuild": false,
    "electronVersion": "28.3.3",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "artifactName": "${productName}-Launcher-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Game",
      "target": [
        "AppImage"
      ]
    }
  }
}
