{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g2u.observation_result.v1",
  "title": "Observation Result v1",
  "description": "Evidence returned by an external sense-only sensor after handling an observation cue.",
  "type": "object",
  "required": ["schema", "event_id", "cue_id", "ts_utc", "ts_source", "node_id", "sensor_id", "result"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "g2u.observation_result.v1" },
    "event_id": { "type": "string", "minLength": 8 },
    "cue_id": { "type": "string", "minLength": 1 },
    "track_id": { "type": "string" },
    "hypothesis_id": { "type": "string" },
    "ts_utc": { "type": "number" },
    "ts_source": { "enum": ["ptp", "gps_pps", "ntp", "monotonic"] },
    "node_id": { "type": "string" },
    "sensor_id": { "type": "string" },
    "result": { "enum": ["observed", "not_observed", "inconclusive", "sensor_unavailable"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bearing_deg": { "type": "number", "minimum": 0, "maximum": 360 },
        "elevation_deg": { "type": "number", "minimum": -10, "maximum": 90 },
        "range_estimate_m": { "type": "number", "minimum": 0 },
        "duration_s": { "type": "number", "minimum": 0 },
        "modality": { "enum": ["rgb", "ptz_rgb", "thermal", "ir", "acoustic", "rf", "mobile_camera"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_uri": { "type": "string" },
        "snapshot_sha256": { "type": "string" },
        "clip_uri": { "type": "string" },
        "clip_sha256": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
