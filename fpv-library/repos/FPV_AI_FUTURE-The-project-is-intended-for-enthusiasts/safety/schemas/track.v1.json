{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g2u.track.v1",
  "title": "G2U Track Event v1",
  "description": "State of a tracked object as published by a ground sky-surveillance node to a downstream UAV-inspector.",
  "type": "object",
  "required": ["schema", "event_id", "track_id", "ts_utc", "ts_source", "node_id", "wgs84", "classification"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "g2u.track.v1" },
    "event_id": { "type": "string", "minLength": 8 },
    "track_id": { "type": "string", "minLength": 1 },
    "ts_utc": { "type": "number" },
    "ts_source": { "enum": ["ptp", "gps_pps", "ntp", "monotonic"] },
    "ts_skew_ms": { "type": "number", "minimum": 0 },
    "node_id": { "type": "string", "minLength": 1 },
    "wgs84": {
      "type": "object",
      "required": ["lat", "lon", "alt_m", "covariance_6x6"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "alt_m": { "type": "number" },
        "covariance_6x6": {
          "description": "Row-major 6x6 covariance: [x, y, z, vx, vy, vz] in ENU. 36 floats.",
          "type": "array",
          "minItems": 36,
          "maxItems": 36,
          "items": { "type": "number" }
        }
      },
      "additionalProperties": false
    },
    "velocity_enu": {
      "type": "object",
      "required": ["vx", "vy", "vz"],
      "properties": {
        "vx": { "type": "number" },
        "vy": { "type": "number" },
        "vz": { "type": "number" },
        "covariance_3x3": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "type": "number" }
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": ["primary_class", "confidence"],
      "properties": {
        "primary_class": {
          "enum": ["multirotor", "fixed_wing", "bird", "aircraft", "helicopter", "balloon", "unknown", "artifact"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "imm_posterior": {
          "type": "object",
          "properties": {
            "multirotor": { "type": "number", "minimum": 0, "maximum": 1 },
            "fixed_wing": { "type": "number", "minimum": 0, "maximum": 1 },
            "bird": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "shape_tree": {
          "type": "object",
          "properties": {
            "airborne": { "type": "number", "minimum": 0, "maximum": 1 },
            "artifact": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "modalities": {
          "type": "array",
          "items": { "enum": ["rgb", "thermal", "rf", "acoustic", "pcl", "lidar"] }
        },
        "agreement_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "first_seen_ts": { "type": "number" },
        "track_age_sec": { "type": "number", "minimum": 0 }
      }
    },
    "ground_node_anchor": {
      "type": "object",
      "properties": {
        "wgs84": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lon": { "type": "number" },
            "alt_m": { "type": "number" }
          }
        },
        "node_health": { "enum": ["green", "amber", "red", "offline"] }
      }
    }
  }
}
