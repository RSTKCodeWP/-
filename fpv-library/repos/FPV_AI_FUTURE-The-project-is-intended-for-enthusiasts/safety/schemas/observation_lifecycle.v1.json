{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g2u.observation_lifecycle.v1",
  "title": "Observation Lifecycle v1",
  "description": "Append-only audit event for the sense-only observation cue lifecycle.",
  "type": "object",
  "required": ["schema", "event_id", "event_type", "cue_id", "ts_utc", "ts_source", "node_id"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "g2u.observation_lifecycle.v1" },
    "event_id": { "type": "string", "minLength": 8 },
    "event_type": {
      "enum": [
        "observation_requested",
        "observation_authorized",
        "observation_denied",
        "observation_expired",
        "observation_result_received"
      ]
    },
    "cue_id": { "type": "string", "minLength": 1 },
    "track_id": { "type": "string" },
    "hypothesis_id": { "type": "string" },
    "operator_id": { "type": "string" },
    "sensor_id": { "type": "string" },
    "result_event_id": { "type": "string" },
    "status_event_id": { "type": "string" },
    "ts_utc": { "type": "number" },
    "ts_source": { "enum": ["ptp", "gps_pps", "ntp", "monotonic"] },
    "node_id": { "type": "string" },
    "reason": { "type": "string" },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": { "type": "string" },
        "phase": { "type": "string" },
        "result": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "modality": { "type": "string" },
        "expires_ts": { "type": "number" },
        "source_event_id": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
