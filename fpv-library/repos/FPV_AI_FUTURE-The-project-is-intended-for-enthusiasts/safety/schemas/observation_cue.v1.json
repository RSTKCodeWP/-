{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g2u.observation_cue.v1",
  "title": "G2U Observation Cue v1",
  "description": "Signed sense-only task for an external mobile or fixed sensor to observe a sky volume and return evidence.",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "cue_id",
    "track_id",
    "ts_utc",
    "ts_source",
    "node_id",
    "expires_ts",
    "sky_volume",
    "task",
    "authorization"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "g2u.observation_cue.v1" },
    "event_id": { "type": "string", "minLength": 8 },
    "cue_id": { "type": "string", "minLength": 1 },
    "track_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string" },
    "evidence_bundle_id": { "type": "string" },
    "ts_utc": { "type": "number" },
    "ts_source": { "enum": ["ptp", "gps_pps", "ntp", "monotonic"] },
    "node_id": { "type": "string", "minLength": 1 },
    "expires_ts": { "type": "number" },
    "sky_volume": {
      "type": "object",
      "required": ["anchor_wgs84", "azimuth_deg", "elevation_deg", "half_angle_deg"],
      "additionalProperties": false,
      "properties": {
        "anchor_wgs84": {
          "type": "object",
          "required": ["lat", "lon", "alt_m"],
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "alt_m": { "type": "number" }
          }
        },
        "azimuth_deg": { "type": "number", "minimum": 0, "maximum": 360 },
        "elevation_deg": { "type": "number", "minimum": -10, "maximum": 90 },
        "half_angle_deg": { "type": "number", "minimum": 0.1, "maximum": 45 },
        "range_min_m": { "type": "number", "minimum": 0 },
        "range_max_m": { "type": "number", "minimum": 0 },
        "uncertainty_3sigma_m": { "type": "number", "minimum": 0 }
      }
    },
    "target_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": ["spatial_anomaly", "persistent_anomaly", "airborne_object", "target_like_unknown", "probable_uav", "unknown"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainty": { "enum": ["low", "medium", "high", "unknown"] },
        "remote_id_present": { "type": "boolean" },
        "target_chip_uri": { "type": "string" },
        "target_chip_sha256": { "type": "string" },
        "reasons_for": { "type": "array", "items": { "type": "string" } },
        "reasons_against": { "type": "array", "items": { "type": "string" } }
      }
    },
    "task": {
      "type": "object",
      "required": ["mode", "objective", "allowed_actions"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "sense_only" },
        "objective": {
          "enum": [
            "observe_sky_volume",
            "collect_visual_confirmation",
            "collect_thermal_confirmation",
            "collect_negative_observation"
          ]
        },
        "requested_modality": {
          "enum": ["rgb", "ptz_rgb", "thermal", "ir", "acoustic", "rf", "mobile_camera"]
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["observe", "record", "report", "return_home", "hold_position"]
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geofence_polygon_wgs84": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "max_altitude_agl_m": { "type": "number", "minimum": 0 },
        "max_observation_speed_mps": { "type": "number", "minimum": 0 },
        "require_operator_review": { "type": "boolean" },
        "sense_only": { "const": true },
        "no_contact": { "const": true },
        "no_countermeasure": { "const": true }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["operator_id", "decision"],
      "additionalProperties": false,
      "properties": {
        "operator_id": { "type": "string" },
        "decision": { "const": "request_observation" },
        "reviewed_at_utc": { "type": "string" },
        "authority_ref": { "type": "string" }
      }
    }
  }
}
